+    def test_g9_snapshot_reads_one_consistent_revocation_state(self):
+        import threading
+        from unittest.mock import patch
+
+        source = self.receipt(101)
+        self.ledger.ingest([source])
+        local_id = self.snap()["originals"][0]["local_id"]
+        with sqlite3.connect(self.path) as db:
+            db.execute("PRAGMA journal_mode=WAL")
+        entered = threading.Event()
+        release = threading.Event()
+        revoked = threading.Event()
+        snap_result = {}
+        revoke_result = {}
+        original_check = SyntheticCaptureLedger._check_source_identity
+
+        def pause_after_first_read(row):
+            entered.set()
+            if not release.wait(5):
+                raise AssertionError("Timed out before completing snapshot")
+            return original_check(row)
+
+        def read_snapshot():
+            try:
+                snap_result["value"] = self.snap()
+            except BaseException as exc:
+                snap_result["error"] = exc
+
+        def revoke_while_snapshot_paused():
+            try:
+                self.ledger.revoke(local_id, "synthetic concurrent revoke")
+                revoke_result["committed"] = True
+                revoked.set()
+            except BaseException as exc:
+                revoke_result["error"] = exc
+
+        with patch.object(SyntheticCaptureLedger, "_check_source_identity",
+                          staticmethod(pause_after_first_read)):
+            reader = threading.Thread(target=read_snapshot, daemon=True)
+            reader.start()
+            self.assertTrue(entered.wait(3), "Snapshot did not reach first source read")
+            writer = threading.Thread(target=revoke_while_snapshot_paused, daemon=True)
+            writer.start()
+            try:
+                # Force the exact reviewer race: in WAL mode the revocation
+                # commits after the first source SELECT but before later
+                # coverage/count queries in the paused snapshot.
+                self.assertTrue(revoked.wait(3), "Writer did not commit in WAL")
+            finally:
+                release.set()
+            reader.join(5)
+            writer.join(5)
+        self.assertFalse(reader.is_alive())
+        self.assertFalse(writer.is_alive())
+        self.assertNotIn("error", snap_result)
+        self.assertNotIn("error", revoke_result)
+        observed = snap_result["value"]
+        # Snapshot may represent a moment before the revoke commits; it must
+        # not combine that version with a subsequent tombstone/count.
+        if observed["originals"]:
+            self.assertEqual(observed["revoked_count"], 0)
+            self.assertEqual(observed["coverage"][0]["state"], "OBSERVED")
+        else:
+            self.assertEqual(observed["revoked_count"], 1)
+            self.assertEqual(observed["coverage"][0]["state"], "REVOKED")
+        self.assertTrue(revoke_result["committed"])
+        self.assertEqual(self.snap()["revoked_count"], 1)
