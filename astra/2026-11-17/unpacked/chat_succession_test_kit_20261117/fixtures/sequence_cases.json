  {
    "id": "S11",
    "title": "Wrong active Project blocks typing; owner repairs route",
    "config": {
      "project": "project-nominated",
      "repo": "JayDEmily/chat_successor",
      "branch": "test/succession",
      "max_unique_chats": 30
    },
    "events": [
      {
        "kind": "response",
        "response_id": "r1",
        "text": "Work update.\nCHAT_STATUS: TASK_COMPLETE",
        "expect": {
          "action": "LAUNCH_SUCCESSOR"
        },
        "repo": {}
      },
      {
        "kind": "dispatch",
        "project": "other-project",
        "expect": {
          "sends": 0,
          "count": 1,
          "halted": true,
          "pending_phase": "prepared"
        }
      },
      {
        "kind": "resume"
      },
      {
        "kind": "dispatch",
        "expect": {
          "sends": 1,
          "count": 2,
          "halted": false
        }
      }
    ]
  },
  {
    "id": "S12",
    "title": "Definitively not sent can be explicitly rearmed",
    "config": {
      "project": "project-nominated",
      "repo": "JayDEmily/chat_successor",
      "branch": "test/succession",
      "max_unique_chats": 30
    },
    "events": [
      {
        "kind": "response",
        "response_id": "r1",
        "text": "Work update.\nCHAT_STATUS: TASK_COMPLETE",
        "expect": {
          "action": "LAUNCH_SUCCESSOR"
        },
        "repo": {}
      },
      {
        "kind": "dispatch",
        "fault": "before_click",
        "expect": {
          "sends": 0,
          "count": 1,
          "halted": true
        }
      },
      {
        "kind": "restart"
      },
      {
        "kind": "not_sent",
        "reason": "Injected adapter trace proves no click happened",
        "expect": {
          "pending_phase": "prepared",
          "halted": false
        }
      },
      {
        "kind": "dispatch",
        "expect": {
          "sends": 1,
          "count": 2
        }
      }
    ]
  },
