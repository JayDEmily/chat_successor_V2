  {
    "id": "S04",
    "title": "Lost successor acknowledgement; restart adopts observed ID without retry",
    "config": {
      "project": "project-nominated",
      "repo": "JayDEmily/chat_successor",
      "branch": "test/succession",
      "max_unique_chats": 30
    },
    "events": [
      {
        "kind": "response",
        "response_id": "r1",
        "text": "Work update.\nCHAT_STATUS: TASK_COMPLETE",
        "expect": {
          "action": "LAUNCH_SUCCESSOR"
        },
        "repo": {}
      },
      {
        "kind": "dispatch",
        "fault": "after_click",
        "expect": {
          "count": 1,
          "sends": 1,
          "pending_phase": "uncertain",
          "halted": true
        }
      },
      {
        "kind": "restart",
        "expect": {
          "count": 1,
          "sends": 1,
          "halted": true
        }
      },
      {
        "kind": "reconcile",
        "expect": {
          "count": 2,
          "sends": 1,
          "action": "WAIT",
          "halted": false
        }
      },
      {
        "kind": "response",
        "response_id": "r1",
        "text": "Work update.\nCHAT_STATUS: TASK_COMPLETE",
        "expect": {
          "action": "IGNORE",
          "sends": 1
        },
        "chat_id": "c1",
        "repo": {}
      }
    ]
  },
