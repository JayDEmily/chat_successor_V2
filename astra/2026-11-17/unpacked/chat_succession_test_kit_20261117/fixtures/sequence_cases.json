[
  {
    "id": "S01",
    "title": "Same-chat continuation, one successor, programme finish",
    "config": {
      "project": "project-nominated",
      "repo": "JayDEmily/chat_successor",
      "branch": "test/succession",
      "max_unique_chats": 30
    },
    "events": [
      {
        "kind": "response",
        "response_id": "r1",
        "text": "Work update.\nCHAT_STATUS: NEED_MORE_TIME",
        "expect": {
          "action": "CONTINUE_CURRENT"
        }
      },
      {
        "kind": "dispatch",
        "expect": {
          "count": 1,
          "sends": 1,
          "opens": 0,
          "current_chat": "c1"
        }
      },
      {
        "kind": "response",
        "response_id": "r1",
        "text": "Work update.\nCHAT_STATUS: NEED_MORE_TIME",
        "expect": {
          "action": "IGNORE"
        }
      },
      {
        "kind": "response",
        "response_id": "r2",
        "text": "Work update.\nCHAT_STATUS: TASK_COMPLETE",
        "expect": {
          "action": "LAUNCH_SUCCESSOR"
        },
        "repo": {}
      },
      {
        "kind": "dispatch",
        "expect": {
          "count": 2,
          "sends": 2,
          "opens": 1
        }
      },
      {
        "kind": "response",
        "response_id": "r3",
        "text": "Work update.\nCHAT_STATUS: TASK_COMPLETE",
        "expect": {
          "action": "STOP_FINISHED",
          "count": 2,
          "sends": 2
        },
        "repo": {
          "programme_complete": true,
          "next_task": null
        }
      }
    ]
  },
